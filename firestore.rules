rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Helper: Validate enquiry schema on public submission
    function isValidEnquiry() {
      let data = request.resource.data;
      return data.fullName is string && data.fullName.size() > 0 &&
             data.email is string && data.email.size() > 3 &&
             data.phone is string && data.phone.size() > 5 &&
             data.projectType is string && data.projectType.size() > 0 &&
             data.description is string && data.description.size() > 5;
    }

    // 1. Customer Project Enquiries
    // Public can CREATE only. Read, Update, Delete are restricted strictly to Authenticated Admins.
    match /project_enquiries/{enquiryId} {
      allow create: if isValidEnquiry();
      allow read, update, delete: if isAdmin();
    }

    // 2. Portfolio Projects
    // Public can READ. Only Authenticated Admins can CREATE, UPDATE, DELETE.
    match /portfolio_projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
